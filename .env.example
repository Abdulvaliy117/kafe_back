SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Номер WhatsApp для заказов (только цифры). Замени на реальный номер Осман Кафе.
WHATSAPP_NUMBER=99670000000

# Стоимость доставки по городу, сом (значение по умолчанию для SiteInfo).
DELIVERY_FEE=100

# Адрес сайта-витрины (для кнопок в шапке админки).
FRONTEND_URL=http://localhost:3000

# --- Прод (Render + Supabase) ---
# DATABASE_URL=postgresql://postgres.<project>:<password>@<host>:5432/postgres
# DEBUG=False
# ALLOWED_HOSTS=.onrender.com
# CSRF_TRUSTED_ORIGINS=https://osman-cafe-front.vercel.app
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://osman-cafe-front.vercel.app
# FRONTEND_URL=https://osman-cafe-front.vercel.app

# --- Фото на Supabase Storage (иначе диск Render эфемерный) ---
# SUPABASE_S3_BUCKET=osman-media
# SUPABASE_S3_ENDPOINT=https://<ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<region>            # напр. eu-central-1 / us-east-1
# SUPABASE_S3_ACCESS_KEY=<access key>
# SUPABASE_S3_SECRET_KEY=<secret key>
# SUPABASE_S3_PUBLIC_URL=<ref>.supabase.co/storage/v1/object/public/osman-media

# Для создания суперюзера без интерактива (пригодится в build.sh на Render):
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me
